          "TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
          "LoyalLevel": 2, // Number 1-4 - default: 1
          "UnlimitedCount": false, // Is trader stock for this item unlimited?
          "StackObjectsCount": 5 // How many items you can buy at one time
        }
      },
      "PriceMultiplier": 6 // General => Price multiplier for default roubles price
    },
    "Universal": {
      "Properties": { // Cores are adding some additional stats to the weapon they are slotted in
        "Ergonomics": 7, // These stats are default ones, each of the Universal Cores are adding or removing some of these stats
