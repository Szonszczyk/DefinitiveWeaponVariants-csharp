{
 // Config of Szonszczyk - Definitive Weapon Variants (DWV)

 // In here you can adjust how you want to get weapon variants in game
 // DO NOT CHANGE ANYTHING IN defaultConfig.jsonc. Run server once or make a copy of this file, rename it to "config.jsonc"
 // Make changes only in config.jsonc to not lose your changes after update!

 // ##########################
 // ### EASY CONFIGURATION ###
 // Simple configuration. If section is marked with "*" there is an advanced configuration available (searchable by number eg. "9.9.")
 
 // ### 1.1. QUALITY GENERATION
 // If variants of this quality will be generated 
 // Change this setting to false, only when you don't have any weapons of this quality in your profile
 "Generate": { // true/false
	 "Unique": true,
	 "Ultimate": true,
	 "Superior": true,
	 "Advanced": true,
	 "Niche": true,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.1. AIRDROP
 // If variants of this quality can be found in Airdrops
 "Airdrop": { // true/false
	 "Unique": false,
	 "Ultimate": true,
	 "Superior": true,
	 "Advanced": true,
	 "Niche": true,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": false
 },

 // ### 2.2. FENCE
 // If variants of this quality can be found in Fence trader shop
 // Warning: You will sometimes see variants without their special attachments that can't be bought anywhere, so they will be useless
 "Fence": { // true/false
	 "Unique": false,
	 "Ultimate": false,
	 "Superior": false,
	 "Advanced": false,
	 "Niche": false,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.3. FLEA MARKET
 // If variants of this quality can be bought/sold on flea market
 "Flea": { // true/false
	 "Unique": false,
	 "Ultimate": false,
	 "Superior": false,
	 "Advanced": false,
	 "Niche": false,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.4. MARKED ROOMS*
 // If variants of this quality can spawn in Customs/Reserve/Streets marked rooms
 "Marked": { // true/false
	"Unique": true,
	"Ultimate": true,
	"Superior": true,
	"Advanced": true,
	"Niche": true,
	"Baseline": false,
	"Flawed": false,
	"Meme": false
 },

 // ### 2.5. LOOT IN CONTAINERS*
 // If variants of this quality can spawn in specific containers on all maps
 // This includes: Weapon boxes, Duffle Bag, Wooden Crates and Caches
 "StaticLoot": { // true/false
	"Unique": false,
	"Ultimate": true,
	"Superior": true,
	"Advanced": true,
	"Niche": false,
	"Baseline": true,
	"Flawed": true,
	"Meme": true
 },

 // ### 2.6. OTHER LOOSE LOOT* - NOT YET IMPLEMENTED
 // If variants of this quality can spawn in places where weapons are spawned
 "LooseLoot": { // true/false
	//"Unique": false,
	//"Ultimate": true,
	//"Superior": true,
	//"Advanced": true,
	//"Niche": false,
	//"Baseline": true,
	//"Flawed": true,
	//"Meme": true
 },

 // ### 3.1. VARIANT CORES*
 // Add special slot to weapon to house "Variant Core" items
 // "Variant Core" items are slightly boosting ergonomics of the weapon or can be exchanged for "Variant Blind Boxes"
 "VariantCoresEnabled": true, // true/false

 // ### 3.2. VARIANT BLIND BOXES*
 // Add special weapon cases that have the same qualities as variants and are containing a random variant weapon of the same quality as box
 "BlindBoxesEnabled": true, // true/false

 // ### 4.1. BUYABLE 12.7x108 CALIBER AMMO*
 // 12.7x108mm caliber ammo is in the game, but is not supposed to be in the loot or any other source of item drops
 // Make 12.7x108mm B-32 accessible to buy in trader
 "SpecialAmmoBuyableEnabled": true,






 // ##############################
 // ### ADVANCED CONFIGURATION ###
 // For advanced users - use only when you have knowledge about JSON arrays!

 // ### 10.1. Remove variant types from generation
 // Add name of variant type ("Meta"/"SMG" etc.) to below array to exclude it from generation
 // Add only variant types of weapons you don't have in your profile
  "NotGenerateVariantTypes": [],

 // ### 10.2. Remove specific weapons from generation
 // Add short weapon name with variant short name (from db/01.Variants, e.g. "AKM Meta") to exclude it from generation
 // Add only weapons you don't have in your profile
  "NotGenerateWeapons": [],

 // ### 11.1. Quality Weights
 // These numbers are weights for loot related stuff
 "QualityWeights": {
	 "Unique": 1,
	 "Ultimate": 2,
	 "Superior": 4,
	 "Advanced": 8,
	 "Niche": 6,
	 "Baseline": 12,
	 "Flawed": 16,
	 "Meme": 20
 },

 // ### 12.1 LOOT PROBABILITIES
 // Probability of finding a variant weapon in percentage
 // This is still random so you will have some lucky and some unlucky streaks!

 // [2.4.] Probability of finding a variant weapon per spawn point
 "MarkedRoomsProbability": 0.30, // percentage (0.30 => 30%) / MIN:0 - MAX:0.99

  // [2.5.] Probability of finding a variant weapon in container
 "StaticLootProbability": 0.30, // percentage (0.30 => 30%) / MIN:0 - MAX:0.99

 // [2.6.] Probability of finding a variant weapon per spawn point (NOT YET IMPLEMENTED)
 "LooseLootProbability": 0, // percentage (0.20 => 20%) / MIN:0 - MAX:0.99

 // ### 13.1 VARIANT CORES
 // Advanced configuration for section 3.1.
 "VariantCores": {
	"FoundOnEnemies": { // Cores can be found in bot pockets - change all probabilities to 0 to disable
		"assault": 0.5 // Scav internal name + probability in percentage (0.50 => 50%) / MIN:0 - MAX:0.99
	},
	"Buyable": false, // If cores can be bought via trader
	"CoresBarter": {
		"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
		"LoyalLevel": 1, // Number 1-4 - default: 1
		"UnlimitedCount": false, // Is trader stock for this item unlimited?
		"StackObjectsCount": 5 // How many items you can buy at one time
	},
	"Price": { // Default value in roubles. They are not that pricey on their own, but their value is in Blind Boxes
		"Unique": 15000,
		"Ultimate": 10000,
		"Superior": 8000,
		"Advanced": 5000,
		"Niche": 6000,
		"Baseline": 4000,
		"Flawed": 3000,
		"Meme": 2000
	}
 },

 // ### 13.2 VARIANT BLIND BOXES
 // Advanced configuration for section 3.2.
 "BlindBoxes": {
	// The price of one lootbox is: "Price" in roubles or "CoresPrice" if "VariantCoresEnabled" is true
	"CoresPrice": 3, // How many cores per Blind Box - if 0, fallback to price
	"Price": { // Changing the price to 0 will disable that blind box from appearing in trader
		"Unique": 250000,
		"Ultimate": 170000,
		"Superior": 95000,
		"Advanced": 75000,
		"Niche": 110000,
		"Baseline": 50000,
		"Flawed": 40000,
		"Meme": 30000
	},
	"BoxesBarter": {
		"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
		"LoyalLevel": 1, // Number 1-4 - default: 1
		"UnlimitedCount": false, // Is trader stock for this item unlimited?
		"StackObjectsCount": 5 // How many items you can buy at one time
	},
	"Width": 3, // Width in inventory
	"Height": 2 // Height in inventory
 },

 // ### 14.1 BUYABLE 12.7x108 CALIBER AMMO
 // Advanced configuration for section 4.1.
 "DWVCaliberBarter": {
	 "TraderId": "SKIER", //Trader name uppercased - default: "SKIER"
	 "LoyalLevel": 1, //Number 1-4 - default: 1
	 "BarterPrice": {
		 "MONEY_ROUBLES": 2500 //Number - default: 2500
	 }
 }
}