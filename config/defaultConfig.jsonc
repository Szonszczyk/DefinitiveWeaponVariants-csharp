{
 // Config of Szonszczyk - Definitive Weapon Variants (DWV)

 // In here you can adjust how you want to get weapon variants in game
 // DO NOT CHANGE ANYTHING IN defaultConfig.jsonc. Run server once or make a copy of this file, rename it to "config.jsonc"
 // Make changes only in config.jsonc to not lose your changes after update!

 // ##########################
 // ### EASY CONFIGURATION ###
 // Simple configuration. If section is marked with "*" there is an advanced configuration available (searchable by number eg. "9.9.")
 
 // ### 1.1. QUALITY GENERATION
 // If variants of this quality will be generated 
 // Change this setting to false, only when you don't have any weapons of this quality in your profile
 "Generate": { // true/false
	 "Unique": true,
	 "Ultimate": true,
	 "Superior": true,
	 "Advanced": true,
	 "Niche": true,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.1. AIRDROP
 // If variants of this quality can be found in Airdrops
 "Airdrop": { // true/false
	 "Unique": false,
	 "Ultimate": true,
	 "Superior": true,
	 "Advanced": true,
	 "Niche": true,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": false
 },

 // ### 2.2. FENCE
 // If variants of this quality can be found in Fence trader shop
 // Warning: You will sometimes see variants without their special attachments that can't be bought anywhere, so they will be useless
 "Fence": { // true/false
	 "Unique": false,
	 "Ultimate": false,
	 "Superior": false,
	 "Advanced": false,
	 "Niche": false,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.3. FLEA MARKET
 // If variants of this quality can be bought/sold on flea market
 "Flea": { // true/false
	 "Unique": false,
	 "Ultimate": false,
	 "Superior": false,
	 "Advanced": false,
	 "Niche": false,
	 "Baseline": true,
	 "Flawed": true,
	 "Meme": true
 },

 // ### 2.4. MARKED ROOMS*
 // If variants of this quality can spawn in Customs/Reserve/Streets marked rooms
 "Marked": { // true/false
	"Unique": true,
	"Ultimate": true,
	"Superior": true,
	"Advanced": true,
	"Niche": true,
	"Baseline": false,
	"Flawed": false,
	"Meme": false
 },

 // ### 2.5. LOOT IN CONTAINERS*
 // If variants of this quality can spawn in specific containers on all maps
 // This includes: Weapon boxes, Duffle Bag, Wooden Crates and Caches
 "StaticLoot": { // true/false
	"Unique": false,
	"Ultimate": true,
	"Superior": true,
	"Advanced": true,
	"Niche": false,
	"Baseline": true,
	"Flawed": true,
	"Meme": true
 },

 // ### 3.1. VARIANT CORES*
 // Add special slot to variant weapons to house "Variant Core" items
 // "Variant Core" items are slightly boosting ergonomics of the weapon or can be exchanged for "Variant Blind Boxes"
 "VariantCoresEnabled": true, // true/false

 // ### 3.2. VARIANT BLIND BOXES*
 // Add special weapon cases that have the same qualities as variants and are containing a random variant weapon of the same quality as box
 "BlindBoxesEnabled": true, // true/false

 // ### 4.1. BUYABLE 12.7x108 CALIBER AMMO*
 // 12.7x108mm caliber ammo is in the game, but is not supposed to be in the loot or any other source of item drops
 // Make 12.7x108mm B-32 accessible to buy in trader
 "SpecialAmmoBuyableEnabled": true, // true/false

 // ### 5. Compatibility with other mods

 // ### 5.1. APBS*
 // Enable automatic creation and update of APBS blacklist (more info can be found on Forge page)
 // Warning: you should create a copy of blacklists.json file (in APBS folder) before enabling
 // Requires: APBS >=2.1.0
 "EnableAPBSBlacklistGeneration": false,  // true/false - default: false
 "APBSFolderName": "acidphantasm-progressivebotsystem", // text - default: "acidphantasm-progressivebotsystem"

 // ### 5.2. Amonya
 // All items added to vanilla traders will be added to Amonya instead
 // Requires: Amonya >=2.0.3
 "AmonyaTraderMode": false,
 // Enabling this option will disable "SpecialAmmoBuyableEnabled" option



 // ##############################
 // ### ADVANCED CONFIGURATION ###
 // For advanced users - use only when you have knowledge about JSON arrays!

 // ### 10.1. Remove variant types from generation
 // Add name of variant type ("Meta"/"SMG" etc.) to below array to exclude it from generation
 // Add only variant types of weapons you don't have in your profile
  "NotGenerateVariantTypes": [],

 // ### 10.2. Remove specific weapons from generation
 // Add short weapon name with variant short name (from db/01.Variants, e.g. "AKM Meta") to exclude it from generation
 // Add only weapons you don't have in your profile
  "NotGenerateWeapons": [],

 // ### 11.1. Quality Weights
 // These numbers are weights for loot related stuff
 "QualityWeights": {
	 "Unique": 1,
	 "Ultimate": 2,
	 "Superior": 4,
	 "Advanced": 8,
	 "Niche": 6,
	 "Baseline": 12,
	 "Flawed": 16,
	 "Meme": 20
 },

 // ### 12.1. LOOT PROBABILITIES
 // Probability of finding a variant weapon in percentage
 // This is still random so you will have some lucky and some unlucky streaks!

 // [2.4.] Probability of finding a variant weapon per spawn point
 "MarkedRoomsProbability": 0.30, // percentage (0.30 => 30%) / MIN:0 - MAX:0.99

  // [2.5.] Probability of finding a variant weapon in container
 "StaticLootProbability": 0.30, // percentage (0.30 => 30%) / MIN:0 - MAX:0.99

 // ### 13.1. VARIANT CORES
 // Advanced configuration for section 3.1.
	"VariantCores": {
		"General": {
			"Price": { // Base price in roubles for each core quality. Used to calculate prices of cores and core-related items
				"Unique": 15000,
				"Ultimate": 10000,
				"Superior": 8000,
				"Advanced": 5000,
				"Niche": 6000,
				"Baseline": 4000,
				"Flawed": 3000,
				"Meme": 2000
			},
			"Required": false // Whether Variant Cores are required for variant weapons to function
			// Note: If this config is enabled, you won't be able to remove Variant Cores from weapons while in raid
			//       Unless you use UI Fixes (https://forge.sp-tarkov.com/mod/1342/ui-fixes) config option: "Modify Weapons In Raid" changed to "Always" or "With Multitool"
			//       This config option will fix variant weapons equipped by APBS bots not having Variant Cores in their usual slot
		},
		"Normal": {
			"Properties": { // Stats added to the weapon while this core is installed
				"Ergonomics": 5
			},
			"Buyable": false, // If cores can be bought via trader
			"Barter": { // Barter setup
				"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
				"LoyalLevel": 1, // Number 1-4 - default: 1
				"UnlimitedCount": false, // Is trader stock for this item unlimited?
				"StackObjectsCount": 5 // How many items you can buy at one time
			},
			"Upgradable": true, // // Cores can be exchanged for their higher-quality counterpart - default: true
			"UpgradableOptions": {
				"UpToQuality": "Baseline", // Highest quality obtainable through upgrading. Example: "Baseline" allows Meme → Flawed → Baseline
				"Ratio": 3, // Number of lower-quality cores required to obtain one higher-quality core
				"Barter": { // Barter setup
					"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
					"LoyalLevel": 1, // Number 1-4 - default: 1
					"UnlimitedCount": false, // Is trader stock for this item unlimited?
					"StackObjectsCount": 5 // How many items you can buy at one time
				}
			},
			"FoundOnEnemies": { // Spawn chance in bot pockets. Set all probabilities to 0 to disable
				"assault": 0.33 // Bot internal name => spawn probability (0.33 = 33%). Range: 0.00-0.99
			},
			"PriceMultiplier": 1 // General => Price multiplier for default roubles price
		},
		"Locked": {
			"Properties": { // Stats added to the weapon while this core is installed
				"Ergonomics": 7,
				"Accuracy": 3
			},
			"Upgradable": true, // Normal cores can be exchanged for their Locked counterpart - default: true
			"UpgradableOptions": {
				"Ratio": 3, // How many normal cores needs to be exchanged for one Locked
				"Barter": {
					"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
					"LoyalLevel": 2, // Number 1-4 - default: 1
					"UnlimitedCount": false, // Is trader stock for this item unlimited?
					"StackObjectsCount": 5 // How many items you can buy at one time
				}
			},
			"PriceMultiplier": 6 // General => Price multiplier for default roubles price
		},
		"Universal": {
			"Properties": { // Stats added to the weapon while this core is installed
				"Ergonomics": 7, // Default stats. Individual Universal Cores may add to or subtract from these values
				"Recoil": 0
			}
		},
		// 3.2. Blind Boxes
		"BlindBoxes": {
			"Properties": { // Size in inventory
				"Width": 3,
				"Height": 2
			},
			"CoresPrice": 3, // Number of the same quality cores needed to buy 1 Blind Box of the same quality
			"Barter": {
				"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
				"LoyalLevel": 1, // Number 1-4 - default: 1
				"UnlimitedCount": false, // Is trader stock for this item unlimited?
				"StackObjectsCount": 20 // How many items you can buy at one time
			},
			"PriceMultiplier": 25 // General => Price multiplier for default roubles price
		},
		"UnknownPackage": {
			"Properties": { // Size in inventory and weight
				"Width": 2,
				"Height": 1,
				"Weight": 1.2
			},
			"PriceInRoubles": 250000,
			"Barter": {
				"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
				"LoyalLevel": 1, // Number 1-4 - default: 1
				"UnlimitedCount": false, // Is trader stock for this item unlimited?
				"StackObjectsCount": 20 // How many items you can buy at one time
			},
			// How many cores will be received from one Unknown Package
			"CoresReceived": 5,
			// Spawn probability in Jackets, Dead Scavs, PC Blocks, Plastic Suitcases and Safes
			"Probability": 0.33 // percentage (0.33 => 33%) / MIN:0 - MAX:0.99
		},
		"ExpeditionaryCase": {
			// Internal storage size for each core quality
			"GridProperties": {
				"CellsH": 1, // Horizontal
				"CellsV": 2 // Vertical
			},
			// Size in inventory and weight
			"Properties": {
				"Width": 1,
				"Height": 1,
				"Weight": 1.2
			},
			"PriceCoreQuality": "Baseline", // Quality of cores used for price
			"PriceCoreAmount": 12, // Number of cores used for price
			"Barter": {
				"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
				"LoyalLevel": 1, // Number 1-4 - default: 1
				"UnlimitedCount": false, // Is trader stock for this item unlimited?
				"StackObjectsCount": 5 // How many items you can buy at one time
			}
		},
		"CarryCase": {
			"GridTypesWidth": {
				"normal": 4, // Storage columns reserved for Normal and Locked Cores
				"universal": 1, // Storage columns reserved for Universal Cores
				"other": 5 // Storage columns reserved for Blind Boxes and Unknown Packages
			},
			"GridHeight": 10, // Storage rows for each type
			"Properties": { // Size in inventory
				"Width": 5,
				"Height": 2
			},
			"PriceCoreQuality": "Baseline", // Quality of cores used for price
			"PriceCoreAmount": 30, // Number of cores used for price
			"Barter": {
				"TraderId": "SKIER", // Trader name uppercased - default: "SKIER"
				"LoyalLevel": 1, // Number 1-4 - default: 1
				"UnlimitedCount": false, // Is trader stock for this item unlimited?
				"StackObjectsCount": 10 // How many items you can buy at one time
			}
		}
	},

 // ### 14.1. BUYABLE 12.7x108 CALIBER AMMO
 // Advanced configuration for section 4.1.
 "DWVCaliberBarter": {
	 "TraderId": "SKIER", //Trader name uppercased - default: "SKIER"
	 "LoyalLevel": 1, //Number 1-4 - default: 1
	 "BarterPrice": {
		 "MONEY_ROUBLES": 2500 //Number - default: 2500
	 }
 },

 // ### 15.1. APBS Compatibility
 // Advanced configuration for section 5.1.

 // 1-7 is minimum bot tier that quality is starting to appear
 // 0 is that tier is not appearing on APBS bots at all
 "APBSTierConfig": {
	"Unique": 0, // Number 0-7 - default: 0 (blacklisted entirely)
	"Ultimate": 7, // Number 0-7 - default: 7 (found on enemies of tier 7)
	"Superior": 6, // Number 0-7 - default: 6 (found on enemies of tier 6-7)
	"Advanced": 5, // Number 0-7 - default: 5 (found on enemies of tier 5-7)
	"Niche": 4, // Number 0-7 - default: 4 (found on enemies of tier 4-7)
	"Baseline": 3, // Number 0-7 - default: 3 (found on enemies of tier 3-7)
	"Flawed": 2, // Number 0-7 - default: 2 (found on enemies of tier 2-7)
	"Meme": 1 // Number 0-7 - default: 1 (found on enemies of all tiers)
 },
 "APBSBlacklistedVariantTypes": ["Rifle Grenade Launcher"]
}