@namespace ModConfigEditor.Components
@* Layout styles compile into the DLL; editable colors live in wwwroot's theme
   file. CSS variables below have fallbacks. Every selector is scoped so
   the editor cannot restyle SPT's navigation or another mod's page. @@ escapes
   Razor's @ character for CSS media queries. No APBS assets or styles are used. *@
<style>
    .mod-config-editor { color: #e6eaf0; background: var(--mc-background, #131a24); padding: 16px 24px; min-height: 100vh; font: 15px/1.55 system-ui, sans-serif; color-scheme: dark; }
    .mod-config-editor * { box-sizing: border-box; }
    .mod-config-editor h1 { font-size: 22px; line-height: 1.25; margin: 0; color: #fff; }
    .mod-config-editor h2 { font-size: 23px; margin: 0 0 8px; color: #fff; }
    .mod-config-editor p { margin: 8px 0 14px; color: #b9c5d5; }
    .mod-config-editor a { color: #8fd8ed; }
    .mod-config-editor .mc-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 20px; padding-bottom: 12px; border-bottom: 1px solid #354256; }
    .mod-config-editor .mc-header-actions { display: flex; justify-content: flex-end; gap: 10px; }
    .mod-config-editor .mc-header-actions button { white-space: nowrap; padding: 6px 12px; }
    .mod-config-editor .mc-header-status { margin: 0; font-size: 13px; }
    .mod-config-editor .mc-header-status.mc-save-confirmation { color: #ff6262; font-size: 20px; font-weight: 800; line-height: 1.3; }
    .mod-config-editor .mc-change-count { font-size: 13px; text-align: right; white-space: nowrap; }
    .mod-config-editor .mc-banner { border: 1px solid #49675c; background: #20372e; padding: 14px 18px; border-radius: 8px; color: #d6eee4; margin: 18px 0; }
    .mod-config-editor button { font: inherit; background: #283649; color: #edf2f8; padding: 8px 14px; border: 1px solid #46566c; border-radius: 6px; cursor: pointer; }
    .mod-config-editor button:hover { background: #34475d; }
    .mod-config-editor button:disabled { opacity: .55; cursor: wait; }
    .mod-config-editor .mc-primary { background: var(--mc-accent, #97dfc3); color: var(--mc-accent-text, #13291f); border-color: var(--mc-accent, #97dfc3); font-weight: 700; }
    .mod-config-editor .mc-primary:hover { filter: brightness(1.08); }
    .mod-config-editor :focus-visible { outline: 3px solid #8bd7f0; outline-offset: 3px; }
    .mod-config-editor .mc-layout { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 24px; margin-top: 10px; }
    .mod-config-editor nav { display: flex; flex-direction: column; gap: 8px; align-self: start; position: sticky; top: 15px; }
    .mod-config-editor nav button, .mod-config-editor .mc-nav-link { text-align: center; background: transparent; border: 1px solid transparent; padding: 8px 14px; border-radius: 6px; color: #edf2f8; font: inherit; text-decoration: none; }
    .mod-config-editor .mc-nav-link { color: #72b7ff; border-color: #72b7ff; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .mod-config-editor .mc-nav-link:hover { background: #203650; }
    .mod-config-editor .mc-nav-divider { width: 100%; border: 0; border-top: 1px solid #46566c; margin: 6px 0; }
    .mod-config-editor nav button[aria-current=page] { background: var(--mc-highlight, #253d37); color: var(--mc-accent, #97dfc3); border-color: var(--mc-accent, #97dfc3); }
    .mod-config-editor main { min-width: 0; background: var(--mc-panel, #1b2533); padding: 24px; border-radius: 10px; }
    .mod-config-editor fieldset { min-width: 0; border: 0; margin: 0; padding: 0; }
    .mod-config-editor .mc-field { padding: 18px 0; border-bottom: 1px solid #354256; }
    .mod-config-editor .mc-field-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .mod-config-editor .mc-subtle { padding: 4px 8px; font-size: 12px; }
    .mod-config-editor input:not([type=checkbox]):not([type=range]), .mod-config-editor select, .mod-config-editor textarea { display: block; width: 100%; max-width: 650px; background: #101925; color: #edf3fc; border: 1px solid #607086; border-radius: 5px; padding: 9px 11px; font: inherit; }
    .mod-config-editor textarea { font-family: ui-monospace, monospace; resize: vertical; }
    .mod-config-editor input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--mc-accent, #97dfc3); vertical-align: middle; }
    .mod-config-editor .mc-number { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; max-width: 650px; }
    .mod-config-editor .mc-number input[type=range] { flex: 1 1 150px; min-width: 100px; accent-color: var(--mc-accent, #97dfc3); cursor: pointer; }
    .mod-config-editor .mc-number input[type=text] { flex: 0 1 140px; width: 140px; min-width: 80px; }
    .mod-config-editor .mc-toggle, .mod-config-editor .mc-choices label { display: flex; align-items: center; gap: 9px; }
    .mod-config-editor .mc-choices { display: flex; flex-wrap: wrap; gap: 12px 25px; }
    .mod-config-editor small { display: block; color: #bac6d4; margin-top: 6px; }
    .mod-config-editor details { margin-top: 10px; }
    .mod-config-editor summary { cursor: pointer; font-weight: 400; font-size: 13px; color: #b9c5d5; padding: 7px 0; }
    .mod-config-editor .mc-object { border-left: 2px solid #547065; padding-left: 18px; }
    .mod-config-editor .mc-unknown { border: 1px dashed #63728a; border-radius: 6px; padding: 10px 16px; margin: 18px 0; }
    .mod-config-editor .mc-row { display: flex; align-items: end; flex-wrap: wrap; gap: 10px; margin: 10px 0; }
    .mod-config-editor .mc-row label { flex: 1; min-width: 140px; }
    .mod-config-editor .mc-raw { align-items: start; }
    .mod-config-editor .mc-error { background: #46282e; color: #ffccd2; border: 1px solid #a45e69; border-radius: 6px; padding: 12px; margin: 12px 0; overflow-wrap: anywhere; }
    .mod-config-editor .mc-notice { color: #f0d795; font-size: 13px; }
    /* display:contents preserves the shared markup while placing the heading's
       label and reset button into separate columns of a compact field row. */
    .mod-config-editor .mc-field-compact { display: grid; grid-template-columns: minmax(90px, .6fr) minmax(140px, 1fr) auto auto; align-items: center; gap: 8px 12px; padding: 9px 0; }
    .mod-config-editor .mc-field-compact > .mc-field-heading { display: contents; }
    .mod-config-editor .mc-field-compact > .mc-field-heading > label { grid-column: 1; grid-row: 1; overflow-wrap: anywhere; }
    .mod-config-editor .mc-field-compact > .mc-field-heading > button { grid-column: 4; grid-row: 1; white-space: nowrap; }
    .mod-config-editor .mc-field-compact > .mc-number, .mod-config-editor .mc-field-compact > .mc-toggle, .mod-config-editor .mc-field-compact > input, .mod-config-editor .mc-field-compact > select { grid-column: 2; grid-row: 1; min-width: 0; }
    .mod-config-editor .mc-field-compact > small { grid-column: 3; grid-row: 1; margin: 0; font-size: 11px; white-space: nowrap; }
    .mod-config-editor .mc-field-compact > .mc-number { flex-wrap: nowrap; gap: 8px; }
    .mod-config-editor .mc-field-compact > .mc-number input[type=text] { flex: 0 1 90px; width: 90px; min-width: 60px; }
    .mod-config-editor .mc-field-compact > .mc-number input[type=range] { min-width: 60px; }
    .mod-config-editor .mc-field-compact > .mc-error, .mod-config-editor .mc-field-compact > .mc-notice { grid-column: 1 / -1; margin: 0; }
    @@media (max-width: 800px) {
        .mod-config-editor { padding: 16px; }
        .mod-config-editor .mc-layout { grid-template-columns: 1fr; }
        .mod-config-editor nav { position: static; flex-direction: row; flex-wrap: wrap; }
        .mod-config-editor main { padding: 16px; }
        .mod-config-editor .mc-header { gap: 4px 12px; }
        .mod-config-editor h1 { font-size: 18px; }
        .mod-config-editor .mc-header-actions { gap: 6px; }
        .mod-config-editor .mc-header-actions button { font-size: 12px; padding: 6px 8px; }
    }
    @@media (max-width: 540px) {
        /* Preserve the two-row grid without overflowing a narrow browser. */
        .mod-config-editor .mc-header h1, .mod-config-editor .mc-header-status { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mod-config-editor .mc-header-status.mc-save-confirmation { white-space: normal; overflow: visible; }
        /* Give narrow windows a readable fallback instead of clipping controls. */
        .mod-config-editor .mc-field-compact { grid-template-columns: minmax(0, 1fr) auto; }
        .mod-config-editor .mc-field-compact > .mc-field-heading > button { grid-column: 2; }
        .mod-config-editor .mc-field-compact > .mc-number, .mod-config-editor .mc-field-compact > .mc-toggle, .mod-config-editor .mc-field-compact > input, .mod-config-editor .mc-field-compact > select { grid-column: 1 / -1; grid-row: 2; }
        .mod-config-editor .mc-field-compact > small { grid-column: 1 / -1; grid-row: 3; }
    }
</style>
