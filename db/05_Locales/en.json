    "Endless_Mag_Shotgun.ShortName": "{Endless.Name} multi-caliber 100-round ammo box",
    "Endless_Mag_Shotgun.VariantType": "{Endless.Name}",
    "Endless_Mag_Sniper.Name": "{Endless.Name} multi-caliber 40-round ammo box",
    "Endless_Mag_Sniper.Description": "A 40-round 7.62x51mm/7.62x54mmR/.338 Lapua Magnum ammo box for {Endless.Name} Variant Type Weapons in the bolt-action rifle category. Manufactured from a shipping container by {Trader.Nickname}",
    "Endless_Mag_Sniper.ShortName": "{Endless.Name} multi-caliber 40-round ammo box",
    "Endless_Mag_Sniper.VariantType": "{Endless.Name}",
    "AMRR_Cylinder.Name": "{Anti-materiel revolver.Name} 12.7x108mm 5-round cylinder",
    "AMRR_Cylinder.Description": "A 5-round 12.7x108mm cylinder for {Anti-materiel revolver.Name} Variant Type Weapons. Now with 50% more wormholes, courtesy of {Trader.Nickname}!",
