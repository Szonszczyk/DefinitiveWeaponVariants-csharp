    "MP155_Unique_Mag.VariantType": "{MP-155 Unique.Name}",
    "PPSh41_Unique_Mag.Name": "{PPSh-41 Unique.Name} 7.62x25 4999-round drum magazine",
    "PPSh41_Unique_Mag.Description": "A 4999-round 7.62x25mm drum magazine for the {PPSh-41 Unique.Name} Variant Weapon\n<b><color=#ff0000>WARNING:</color></b> If it's empty, do not let it float away!\n~{Trader.Nickname}",
